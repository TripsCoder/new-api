map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    include /etc/nginx/conf.d/includes/frontend-http.conf;
    include /etc/nginx/conf.d/includes/frontend-locations.conf;
}

include /etc/nginx/conf.d/includes/frontend-ssl.conf;
