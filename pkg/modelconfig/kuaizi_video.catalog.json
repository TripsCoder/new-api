        "readAt": "2026-11-12",
        "scope": "筷子科技万相 3.0 视频生成兼容接口 v1.2",
        "status": "public-documentation"
      },
      "schema": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "wan3.0-video",
              "wan3.0-video-prime"
            ]
          },
          "input": {
            "type": "object",
            "anyOf": [
              {
                "required": [
                  "prompt"
                ]
              },
              {
                "required": [
                  "media"
                ]
              }
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "media": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "first_frame",
                        "last_frame",
                        "reference_image",
                        "reference_video",
                        "reference_audio",
                        "file",
                        "link"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https?://"
                    }
                  }
                }
              }
            }
          },
          "parameters": {
            "type": "object",
            "properties": {
              "resolution": {
                "type": "string",
                "enum": [
                  "480P",
                  "720P",
                  "1080P"
                ],
                "default": "1080P"
              },
              "ratio": {
                "type": "string",
                "enum": [
                  "adaptive",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "adaptive"
              },
              "duration": {
                "type": "integer",
                "minimum": -1,
                "maximum": 30,
                "anyOf": [
                  {
                    "const": -1
                  },
                  {
                    "minimum": 2,
                    "maximum": 30
                  }
                ],
                "default": 5
              },
              "audio": {
                "type": "boolean",
                "default": true
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "watermark": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
