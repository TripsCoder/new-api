    {
      "name": "multipart forwards the original opaque file reference",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "client-alias",
          "upstreamModel": "new-account-video-id",
          "baseUrl": "https://supplier.example/v1",
          "apiKey": "fixture-only",
          "publicTaskId": "task_public",
          "files": [
            {
              "ref": "request_file:input_reference",
              "field": "input_reference",
              "filename": "reference.png",
              "mimeType": "image/png",
              "size": 100
            }
          ],
          "requestBody": {
            "operation": "video_generate",
            "protocolTemplate": "interface:ac205b7903df54b7",
            "input": {
              "prompt": "Fixture",
              "seconds": 5,
              "size": "9:16"
            },
            "uploads": [
              {
                "ref": "request_file:input_reference",
                "field": "input_reference",
                "filename": "reference.png",
                "mimeType": "image/png",
                "size": 100
              }
            ]
          }
        }
      ],
      "expected": {
        "url": "https://supplier.example/v1/videos",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Accept": "application/json"
        },
        "bodyType": "multipart",
        "parts": [
          {
            "name": "model",
            "value": "new-account-video-id"
          },
          {
            "name": "prompt",
            "value": "Fixture"
          },
          {
            "name": "seconds",
            "value": "5"
          },
          {
            "name": "size",
            "value": "9:16"
          },
          {
            "name": "input_reference",
            "fileRef": "request_file:input_reference",
            "filename": "reference.png"
          }
        ]
      }
    },
