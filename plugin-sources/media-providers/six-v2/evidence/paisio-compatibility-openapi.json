    },
    "components": {
      "schemas": {
        "VideoRequest": {
          "type": "object",
          "required": [
            "model",
            "prompt"
          ],
          "properties": {
            "model": {
              "type": "string",
              "description": "视频模型名称。\n\n## 按秒计费模型（费用 = 单价 × 时长秒数）\n| 模型 | 单价（🔥/秒） | 说明 |\n|------|-------------|------|\n| video-fast-480p | 0.32 | 快速生成 480p |\n| video-fast-720p | 0.47 | 快速生成 720p |\n| video-pro-480p | 0.39 | 高质量 480p |\n| video-pro-720p | 0.56 | 高质量 720p |\n| video-pro-1080p | 0.85 | 高质量 1080p |\n| video1-pro-480p | 0.41 | Pro加速 480p |\n| video1-pro-720p | 0.56 | Pro加速 720p |\n| video1-pro-1080p | 0.86 | Pro加速 1080p |\n| video-pro-4K | 1.85 | 超高清 4K |\n| video1-fast-720 | 0.47 | Fast加速 720p |\n| sd2-fast-pro | 0.25 | 极速 Pro（仅10/15秒） |\n| sd2-pro | 0.31 | Pro版（仅10/15秒） |\n\n## 按次计费模型（固定费用）\n| 模型 | 单价（🔥/次） | 说明 |\n|------|-------------|------|\n| seedance-2-fast | 5.5 | 快速版 |\n| seedance-2 | 7 | 标准版 |\n| seedance-2-pro-1080p | 12 | 1080p 高清版 |\n| grok-imagine-video-1.5 | 0.35 | Grok 图生视频，1-15秒，**必须传参考图**，仅支持1张 |\n| grok-imagine-video-1.5-fast | 0.28 | Grok 文/图生视频（快速），仅支持6或10秒，最多7张参考图 |",
              "enum": [
                "video-fast-480p",
                "video-fast-720p",
                "video-pro-480p",
                "video-pro-720p",
                "video-pro-1080p",
                "video1-pro-480p",
                "video1-pro-720p",
                "video1-pro-1080p",
                "video-pro-4K",
                "video1-fast-720",
                "sd2-fast-pro",
                "sd2-pro",
                "seedance-2-fast",
                "seedance-2",
                "seedance-2-pro-1080p",
                "grok-imagine-video-1.5",
                "grok-imagine-video-1.5-fast"
              ]
            },
            "prompt": {
              "type": "string",
              "description": "视频描述提示词，最多 2500 字符。\n\n引用素材时在文本中插入占位符：@Image1~@Image9、@Video1~@Video3、@Audio1~@Audio3。"
            },
            "duration": {
              "type": "integer",
              "description": "视频时长（秒）。不同模型支持的范围不同，详见模型说明。",
              "default": 6
            },
            "aspect_ratio": {
              "type": "string",
              "description": "画面比例。支持：16:9、9:16、1:1、21:9、3:4、4:3",
              "default": "16:9"
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "首帧图片或参考图片的 URL（图生视频时必填）。必须为公网可访问的 HTTPS 链接。"
            },
            "extra_images": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "description": "额外参考图片 URL 数组，最多 9 张。在 prompt 中用 @Image2~@Image9 引用。"
            },
            "extra_videos": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "description": "参考视频 URL 数组，最多 3 个。在 prompt 中用 @Video1~@Video3 引用。"
            },
            "extra_audios": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "description": "参考音频 URL 数组，最多 3 个。在 prompt 中用 @Audio1~@Audio3 引用。"
            }
          },
          "x-apifox-orders": [
            "model",
            "prompt",
            "duration",
            "aspect_ratio",
            "image_url",
            "extra_images",
            "extra_videos",
            "extra_audios"
          ],
          "x-apifox-ignore-properties": [],
          "x-apifox-folder": ""
        },
        "VideoSubmitResponse": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "description": "任务ID，用于轮询状态",
              "examples": [
