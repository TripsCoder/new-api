              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending"
              ],
              "examples": [
                "pending"
              ]
            },
            "model": {
              "type": "string",
              "examples": [
                "sd2-720p"
              ]
            }
          },
          "x-apifox-orders": [
            "task_id",
            "status",
            "model"
          ],
          "x-apifox-ignore-properties": [],
          "x-apifox-folder": ""
        }
      },
      "securitySchemes": {
