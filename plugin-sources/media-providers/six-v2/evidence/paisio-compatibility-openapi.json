          "operationId": "submitVideoCompat",
          "tags": [
            "视频生成",
            "视频生成"
          ],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoRequest"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "任务提交成功",
